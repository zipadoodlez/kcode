/target
__pycache__/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# graphify: graph.json and GRAPH_REPORT.md travel with the repo. The incremental
# cache, the daily pre-overwrite backups, the machine-specific
# interpreter/root/label sidecars, and the HTML visualization (disabled for the
# committed hooks in .graphifyrc) do not.
graphify-out/*/
graphify-out/manifest.json
graphify-out/graph.html
graphify-out/.graphify_*
