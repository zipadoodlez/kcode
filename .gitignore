/target
__pycache__/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# graphify's graph is a derived, machine-local cache: AST plus docs, rebuilt by
# the committed hooks. It is not tracked, because a committed copy is neither
# reproducible (community assignment depends on the environment) nor current.
graphify-out/

# makepkg build artifacts for the Arch recipe in packaging/arch/. The bare
# clone in `kcode-git/` is the local reference makepkg keeps for the `git+`
# source; it holds a full pack of this repository, so committing it would add
# tens of megabytes of binary history.
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/kcode-git/
packaging/arch/*.pkg.tar.*
