# Maintainer: Khaled Jaafar <khaled@jaafar.ca>

# kcode has no tags and no CI, so this tracks the default branch rather than a
# release tarball. Build and install with `makepkg -si`, or build into a local
# repository with `aur build` and let pacman install it. See README "Install".
pkgname=kcode-git
pkgver=r5798.f705799
pkgrel=1
pkgdesc="Kcode: a fast, focused coding agent (TUI, multi-model, swarm coordination)"
arch=('x86_64')
url="https://github.com/zipadoodlez/kcode"
license=('MIT')
depends=('libgcc') # from `ldd`: libc, libm and libgcc_s are the only shared libs
makedepends=('rust') # provides cargo; there is no separate cargo package
provides=('kcode')
conflicts=('kcode')
# Arch's makepkg OPTIONS enables `lto`, which compiles ring's and aws-lc's C and
# assembly to GIMPLE-only objects; rustc's final link does not run -flto, so
# every symbol they define is undefined at link time. The project itself only
# enables LTO in the separate release-lto profile, never in release.
options=('!lto')
source=("$pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
	cd "$pkgname"
	printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
	cd "$pkgname"
	# Not --frozen: kgrep is a git dependency, so the build needs the network.
	cargo build --release --locked -p kcode --bin kcode
}

package() {
	cd "$pkgname"
	install -Dm755 target/release/kcode "$pkgdir/usr/bin/kcode"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
